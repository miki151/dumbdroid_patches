From 3f8d132171257a2d7ab3b5bb5e12fd2a9a98211a Mon Sep 17 00:00:00 2001
From: Michal Brzozowski <miki@extremic.com>
Date: Tue, 13 Jan 2026 10:58:18 +0100
Subject: [PATCH 26/27] Remove play store and gms installations when booting
 the vanilla variant

Change-Id: Ic4e8f56d54d696a2576b751e2e4fd9dfcc87914d
---
 phh-on-boot.sh | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/phh-on-boot.sh b/phh-on-boot.sh
index d2d5b0a..5069baf 100644
--- a/phh-on-boot.sh
+++ b/phh-on-boot.sh
@@ -52,6 +52,16 @@ if [ "$vndk" = 28 ];then
     mount $minijailSrc /vendor/lib/libminijail.so
 fi
 
+# Remove Play Store/Play Services updates on microG builds.
+if [ "$(getprop ro.dumbdroid.branch)" = "vanilla" ]; then
+    for pkg in com.android.vending com.google.android.gms; do
+        if pm path "$pkg" 2>/dev/null | grep -q '^package:/data/'; then
+            pm uninstall-system-updates "$pkg" >/dev/null 2>&1
+            pm install-existing --user 0 "$pkg" >/dev/null 2>&1
+        fi
+    done
+fi
+
 #Clear looping services
 sleep 30
 getprop | \
-- 
2.34.1

