---
 core/res/res/values/symbols.xml            |   4 ++++
 keystore/prebuilts/bouncycastle/Android.bp |  25 +++++++++++++++++++++
 keystore/prebuilts/bouncycastle/bcpkix.jar | Bin 0 -> 1167476 bytes
 keystore/prebuilts/bouncycastle/bcprov.jar | Bin 0 -> 7128768 bytes
 keystore/prebuilts/bouncycastle/bcutil.jar | Bin 0 -> 714832 bytes
 5 files changed, 29 insertions(+)
 create mode 100644 keystore/prebuilts/bouncycastle/Android.bp
 create mode 100644 keystore/prebuilts/bouncycastle/bcpkix.jar
 create mode 100644 keystore/prebuilts/bouncycastle/bcprov.jar
 create mode 100644 keystore/prebuilts/bouncycastle/bcutil.jar

diff --git a/core/res/res/values/symbols.xml b/core/res/res/values/symbols.xml
index ffe4ac940a55..2a6294284aaf 100644
--- a/core/res/res/values/symbols.xml
+++ b/core/res/res/values/symbols.xml
@@ -22,6 +22,10 @@
        Can be referenced in java code as: com.android.internal.R.<type>.<name>
        and in layout xml as: "@*android:<type>/<name>"
   -->
+  <java-symbol type="string" name="global_action_factory_reset" />
+  <java-symbol type="string" name="global_action_factory_reset_message" />
+  <java-symbol type="string" name="global_action_factory_reset_confirm" />
+  <java-symbol type="string" name="prox_touch_block_message" />
   <java-symbol type="id" name="account_name" />
   <java-symbol type="id" name="account_row_icon" />
   <java-symbol type="id" name="account_row_text" />
diff --git a/keystore/prebuilts/bouncycastle/Android.bp b/keystore/prebuilts/bouncycastle/Android.bp
new file mode 100644
index 000000000000..8e16fff48b8b
--- /dev/null
+++ b/keystore/prebuilts/bouncycastle/Android.bp
@@ -0,0 +1,25 @@
+// frameworks/base/keystore/prebuilts/bouncycastle/Android.bp
+java_import {
+    name: "bouncycastle_asn1",
+    jars: ["bcprov.jar"],
+    sdk_version: "current",        // you’re targeting platform code, not the SDK
+    host_supported: true,       // if you ever run host‐side tests
+    compile_dex: true,         // no need for dex’ing in the platform
+    visibility: ["//visibility:public"],
+}
+
+java_import {
+    name: "bouncycastle_pkix",
+    jars: ["bcpkix.jar"],
+    sdk_version: "none",        // platform code
+    host_supported: true,       // if you run host tests
+    compile_dex: false,         // no dex in platform
+}
+
+java_import {
+    name: "bouncycastle_util",
+    jars: ["bcutil.jar"],
+    sdk_version: "none",        // platform code
+    host_supported: true,       // if you run host tests
+    compile_dex: false,         // no dex in platform
+}
