diff --git a/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/PendingPinInput.kt b/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/PendingPinInput.kt
index 0d0faa767308..7095b5969f2c 100644
--- a/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/PendingPinInput.kt
+++ b/packages/SystemUI/src/com/android/systemui/keyguard/domain/interactor/PendingPinInput.kt
@@ -1,12 +1,19 @@
 package com.android.systemui.keyguard.domain.interactor
 
 object PendingPinInput {
+    fun interface Listener {
+        fun onPendingPinChanged()
+    }
+
     @JvmStatic
     var digits: String = ""
 
+    private val listeners = ArrayList<Listener>()
+
     @JvmStatic
     fun addDigit(d: Char) {
         digits += d
+        notifyListeners()
     }
 
     @JvmStatic
@@ -14,9 +21,33 @@ object PendingPinInput {
         return digits
     }
 
+    @JvmStatic
+    fun take(): String {
+        val pending = digits
+        digits = ""
+        return pending
+    }
+
     @JvmStatic
     fun reset() {
         digits = ""
     }
-}
 
+    @JvmStatic
+    fun addListener(listener: Listener) {
+        if (!listeners.contains(listener)) {
+            listeners.add(listener)
+        }
+    }
+
+    @JvmStatic
+    fun removeListener(listener: Listener) {
+        listeners.remove(listener)
+    }
+
+    private fun notifyListeners() {
+        for (listener in listeners) {
+            listener.onPendingPinChanged()
+        }
+    }
+}
